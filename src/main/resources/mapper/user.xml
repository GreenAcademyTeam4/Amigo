<?xml version="1.0" encoding="UTF-8" ?>
<!-- mapper DTD 선언 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.amigo_project.repository.interfaces.UserRepository">
    <select id="checkUserId" resultType="boolean" parameterType="String">
        SELECT COUNT(*)
        FROM user_tb
        WHERE user_id = #{userId}
    </select>
    <insert id="create" parameterType="com.example.amigo_project.dto.UserDTO">
        INSERT INTO user_tb (
            user_id, name, password, phone_number, gender, birth
        ) VALUES (
            #{userId}, #{name}, #{password}, #{phoneNumber}, #{gender}, #{birth}
        )
    </insert>
    
    <select id="loginByUserIdAndPassword" resultType="com.example.amigo_project.repository.model.User">
        SELECT *
        FROM user_tb
        WHERE user_id = #{userId}
        AND password = #{password}
    </select>
    <select id="findByUserId"  parameterType="com.example.amigo_project.dto.UserDTO">
        SELECT *
        FROM user_tb
        WHERE user_id = #{userId} 
    </select>
    
  
    <insert id="kakaoInsert" parameterType="java.util.HashMap">
		insert into user_tb(user_id, password)
			values(#{kakaoId}, #{kakaoPassword})
	</insert> 
  
    <insert id="googleInsert" parameterType="java.util.HashMap">
		insert into user_tb(user_id, password)
			values(#{email}, #{googlePassword})
	</insert> 

    <select id="findPasswordByUserId" resultType="String">
        select password
        from user_tb
        where id = #{userId}
    </select>
    <insert id="naverInsert" parameterType="java.util.HashMap">
    INSERT INTO user_tb (user_id, password)
    VALUES (#{naverId}, #{naverPassword})
</insert>

    <select id="findUserById" resultType="com.example.amigo_project.repository.model.User">
        select * from user_tb
        where id = #{id}
    </select>

    <update id="updatePasswordByUserId">
        update user_tb
        set password = #{password}
        where id = #{userId}
    </update>
</mapper>