<html>
<body>
<header>
    <div class="alarm-box">
        <div class="alarm-list">
            <div class="sender-profile"></div>
            <div class="sender-nickname"></div>
            <div class="alarm-content"></div>
        </div>
    </div>
    <div class="voice-chat hide">
        <div class="sender-profile"></div>
        <div class="sender-nickname"></div>
        <div class="btn-area">
            <button class="accept-btn"></button>
            <button class="refuse-btn"></button>
        </div>
    </div>
    <div class="logo">
        <img src="/image/logo.png">
    </div>
    <div class="school-select">
        <div class="current-school">
            {{!{{current_school.name}}
        </div>
        {{!
        {{#other_school}} {{!TODO 스타일을 disabled로 숨기고 hover로 마우스를 올릴때 뜨게 설계}}
            <div class="other-school" data-id="아이디"> {{!학교 id를 div 속성에 숨겨두기}}
        {{!    {{name}}
            </div>
        {{!{{/other_school}}
    </div>

        <div class="nav-area">
            <a href="#">친구</a>
            <a href="#">매점</a>
            <a href="#">공지</a>
            <a href="#">쪽지</a>
            <a href="/my-page/info">마이페이지</a>
            <a href="/store/shop">상점</a>
        </div>
        {{#principal}}
        <div id="login-btn" class="transition-link" >
            <a href="/logout">Logout</a>
        </div>
        {{/principal}}
        <div class="nav-area">
            <img src="/image/alarm/alarm.png" id="alarm-icon">
            <a href="#">Support</a>
             <a href="#">Blog</a>
        </div>
        {{^principal}}
        <div id="login-btn" class="transition-link" >
            <a href="/login">Login</a>
        </div>
        {{/principal}}

</header>
