<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>환불 사유 입력</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
<h1>환불 신청</h1>
<form id="refundReason" method="post" action="/pay/refundForm" target="submitFrame">
    <p>주문 이름: {{chargeHistory.orderName}}</p>
    <p>주문 번호: {{chargeHistory.orderId}}</p>
    <div class="form-check">
        <label class="form-check-label">
            <input type="checkbox" class="form-check-input" name="reason" value="단순 변심">단순 변심
        </label>
    </div>
    <div class="form-check">
        <label class="form-check-label">
            <input type="checkbox" class="form-check-input" name="reason" value="잘못 구매했어요.">잘못 구매했어요.
        </label>
    </div>
    <div class="form-check">
        <label class="form-check-label">
            <input type="checkbox" class="form-check-input" name="reason" value="결제 수단을 잘못 선택했어요.">
            결제 수단을 잘못 선택했어요.
        </label>
    </div>
    <div class="form-check">
        <label class="form-check-label">
            <input type="checkbox" id="otherReasonCheckbox" class="form-check-input" name="reason" value="기타 사유">
            기타 사유
        </label>
    </div>
    <div class="form-group">
        <label for="comment">환불 사유를 입력해주세요.</label>
        <textarea class="form-control" rows="5" id="comment"
                  name="reason" maxlength="200" disabled></textarea>
        <div class="count-container">
            글자수: <span id="charCount">0</span> / 200
        </div>
    </div>
    <input type="hidden" name="id" value="{{chargeHistory.id}}">
    <br>
    <button type="submit">환불 신청</button>
</form>

<iframe name="submitFrame" style="display:none;"></iframe>

<script src="/js/payment/refundReason.js"></script>

</body>
</html>
