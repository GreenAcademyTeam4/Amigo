{{>layout/admin/adminSidebar}}

<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>결제 관리</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            background-color: #f4f6f9;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .content-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 20px;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            color: #2c3e50;
            text-align: left;
            font-size: 24px;
            font-weight: bold;
            border-bottom: 2px solid #34495e;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .search-bar {
            margin-bottom: 20px;
            display: flex;
            justify-content: flex-end;
        }

        .search-bar input[type="text"] {
            width: 300px;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 15px;
            text-align: center;
        }

        th {
            background-color: #34495e;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        tr:hover {
            background-color: #f1f1f1;
        }

        .pagination {
            display: flex;
            justify-content: center;
            margin-top: 20px;
            list-style: none;
            padding-left: 0;
        }

        .pagination li {
            margin: 0 5px;
        }

        .pagination a {
            text-decoration: none;
            color: #34495e;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .pagination a:hover {
            background-color: #34495e;
            color: #fff;
        }

        .page-item.active a {
            background-color: #34495e;
            color: #fff;
        }

        /* 검색 결과가 없을 때 표시될 메시지 스타일 */
        .no-results {
            text-align: center;
            color: #888;
            font-size: 18px;
            padding: 20px;
            display: none; /* 기본적으로 숨김 */
        }
    </style>
</head>

<body>
<div class="content-container">
    <h1>결제 조회</h1>

    <!-- 검색바 -->
    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="검색어를 입력하세요...">
    </div>

    <div class="requestRefundList">
        <table>
            <thead>
            <tr>
                <th>결제 내역 번호</th>
                <th>이름</th>
                <th>주문 이름</th>
                <th>주문 번호</th>
                <th>금액</th>
                <th>시간</th>
                <th>결제 방법</th>
            </tr>
            </thead>
            <tbody id="refundList">
            {{#chargeHistoryList}}
                <tr>
                    <td>{{id}}</td>
                    <td>{{name}}</td>
                    <td>{{orderName}}</td>
                    <td>{{orderId}}</td>
                    <td>{{totalAmount}}</td>
                    <td>{{approvedAt}}</td>
                    <td>{{method}}</td>
                </tr>
            {{/chargeHistoryList}}
            </tbody>
        </table>

        <!-- 검색 결과가 없을 때 표시할 메시지 -->
        <div class="no-results" id="noResultsMessage">결과가 없습니다.</div>

        <!-- 페이징 섹션 -->
        <ul class="pagination" id="pagination"></ul>
    </div>
</div>

<script>
    $(document).ready(function () {
        const rowsPerPage = 10;
        const $tableBody = $("#refundList");
        const rows = $tableBody.find("tr");
        let filteredRows = rows;
        const $pagination = $("#pagination");
        const $noResultsMessage = $("#noResultsMessage");

        // 검색 기능
        $("#searchInput").on("keyup", function() {
            const searchText = $(this).val().toLowerCase();

            // 입력한 검색어에 따라 행 필터링
            filteredRows = rows.filter(function() {
                const rowText = $(this).text().toLowerCase();
                return rowText.includes(searchText);
            });

            // 검색 결과가 없을 때 메시지 표시
            if (filteredRows.length === 0) {
                $tableBody.hide();
                $noResultsMessage.show(); // 결과가 없을 때만 표시
                $pagination.hide(); // 페이지네이션 숨기기
            } else {
                $tableBody.show();
                $noResultsMessage.hide(); // 결과가 있을 때 메시지 숨기기
                renderPagination();
                displayRows(0, rowsPerPage);
            }
        });

        // 행 표시 함수
        function displayRows(startIndex, endIndex) {
            rows.hide(); // 모든 행을 숨김
            filteredRows.slice(startIndex, endIndex).show(); // 필터링된 행만 표시
        }

        // 페이징 버튼 생성 및 렌더링 함수
        function renderPagination() {
            const pageCount = Math.ceil(filteredRows.length / rowsPerPage);
            $pagination.empty();

            if (pageCount > 0) { // 페이징 버튼이 있을 때만 추가
                for (let i = 1; i <= pageCount; i++) {
                    $pagination.append(`<li class="page-item"><a href="#" class="page-link">${i}</a></li>`);
                }
                $pagination.find("li").first().addClass("active");
                $pagination.show(); // 페이지네이션 표시
            }
        }

        // 페이지 클릭 시 표시할 행 설정
        $pagination.on("click", "a", function(e) {
            e.preventDefault();
            const pageIndex = $(this).text() - 1;
            const start = pageIndex * rowsPerPage;
            const end = start + rowsPerPage;

            displayRows(start, end);

            $pagination.find("li").removeClass("active");
            $(this).parent().addClass("active");
        });

        // 초기화
        renderPagination();
        displayRows(0, rowsPerPage);
        $('#refundList tr').each(function () {
            const $cell = $(this).find('td').eq(5);
            const originalTime = $cell.text().trim();
            if (originalTime) {
                const date = new Date(originalTime);
                const formattedTime = formatDate(date);
                $cell.text(formattedTime);
            }
        });
    });

    // 날짜를 YY-MM-DD HH:mm:ss 형식으로 포맷팅하는 함수
    function formatDate(date) {
        const year = String(date.getFullYear()).slice(2);
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        const seconds = String(date.getSeconds()).padStart(2, '0');
        return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
    }
</script>
</body>

</html>
