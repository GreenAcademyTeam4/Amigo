{{>layout/admin/adminSidebar}}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>관리자 대시보드</title>
    <link href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css" rel="stylesheet">
    <style>
        /* 기본 설정 */
        body {

            background-color: #e9ecef;
            overflow-x: hidden;
        }

        /* 메인 컨테이너 */
        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 20px;
            border-bottom: 2px solid #e0e0e0;
            padding-bottom: 20px;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            animation: fadeIn 0.6s ease;
        }

        /* 통계 카드 스타일 */
        .stats-cards {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            justify-content: space-around;
            flex-wrap: wrap;
        }
        .card {
            background-color: #f8f9fa;
            border-left: 5px solid #007bff;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
            text-align: center;
            flex: 1;
            min-width: 200px;
            transition: transform 0.3s, box-shadow 0.3s;
            animation: bounceIn 0.6s ease;
        }
        .card h4 {
            font-size: 16px;
            color: #6c757d;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }
        .card h4 i {
            font-size: 20px;
            color: #007bff;
        }
        .card p {
            font-size: 28px;
            color: #333;
            font-weight: bold;
            margin: 10px 0;
            font-family: 'Arial', sans-serif;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
            background-color: #e2e6ea;
        }

        /* 카드 색상 */
        .card:nth-child(1) { border-left-color: #007bff; }
        .card:nth-child(2) { border-left-color: #ffc107; }
        .card:nth-child(3) { border-left-color: #17a2b8; }
        .card:nth-child(4) { border-left-color: #28a745; }

        /* 차트와 리스트 가로 정렬 */
        .charts-and-list {
            display: flex;
            gap: 20px;
            margin-top: 20px;
            align-items: stretch;
        }

        /* 가장 잘 팔린 상품 스타일 */
        .best-selling-products-container {
            background-color: #f8f9fa;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 100%;
            max-width: 100%;
            height: auto;
            text-align: left;
            transition: transform 0.3s, box-shadow 0.3s;
            flex: 1;
            overflow: hidden;
        }
        .best-selling-products-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
            background-color: #e2e6ea;
        }
        .best-selling-products-container h6 {
            font-weight: bold;
            color: #34495e;
            margin-bottom: 15px;
            font-size: 18px;
            border-bottom: 2px solid #e0e0e0;
            padding-bottom: 5px;
        }
        .best-selling-products-container ol {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .best-selling-products-container li {
            font-size: 16px;
            margin: 8px 0;
            color: #5a5a5a;
            display: flex;
            align-items: center;
            transition: transform 0.3s, color 0.3s ease;
            animation: slideIn 0.4s ease forwards;
            opacity: 0;
        }
        .best-selling-products-container li:hover {
            transform: translateX(8px);
            color: #007bff;
        }
        .best-selling-products-container li::before {
            content: "🏆";
            margin-right: 8px;
            color: #ffc107;
            animation: bounce 1.5s infinite alternate;
        }

        /* 차트 스타일 */
        .chart-container {
            display: flex;
            gap: 20px;
            flex: 2;
        }
        .small-chart {
            background-color: #f8f9fa;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
            flex: 1;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .small-chart:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
            background-color: #e2e6ea;
        }
        canvas {
            width: 100%;
            height: 180px;
        }

        /* 애니메이션 */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes bounceIn {
            0% { transform: scale(0.95); opacity: 0; }
            80% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(1); }
        }
        @keyframes bounce {
            from { transform: translateY(0); }
            to { transform: translateY(-5px); }
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-30px); }
            to { opacity: 1; transform: translateX(0); }
        }
    </style>
</head>
<body>

<div class="container">
    <!-- 통계 카드 섹션 -->
    <div class="stats-cards">
        <div class="card">
            <h4><i class="icon">👥</i>유저 수</h4>
            <p id="totalUserCount">0명</p>
        </div>
        <div class="card">
            <h4><i class="icon">📝</i>가입자 수</h4>
            <p id="totalMembers">0명</p>
        </div>
        <div class="card">
            <h4><i class="icon">🌐</i>하루 방문 수</h4>
            <p id="dailyVisits">0명</p>
        </div>
        <div class="card">
            <h4><i class="icon">💰</i>총 매출 금액</h4>
            <p id="totalRevenueAmount">₩0</p>
        </div>
    </div>

    <!-- 메인 콘텐츠 (차트와 리스트) -->
    <div class="charts-and-list">
        <!-- 가장 잘 팔린 상품 리스트 -->
        <div class="best-selling-products-container">
            <h6>가장 인기 많은 상품 TOP 3</h6>
            <ol id="bestSellingProductList">
                <li>로딩 중...</li>
            </ol>
        </div>

        <!-- 차트 섹션 (남녀 성비, 나이 분포) -->
        <div class="chart-container">
            <div class="small-chart">
                <h4>남녀 성비</h4>
                <canvas id="genderChart"></canvas>
            </div>
            <div class="small-chart">
                <h4>나이 분포</h4>
                <canvas id="ageDistributionChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        getTotalUserCount();
        getTotalMemberCount();
        getTotalRevenue();
        getDailyVisits();
        getBestSellingProducts();
        loadGenderData();
        loadAgeData();
    });

    function getTotalUserCount() {
        fetch('/admin/totalUsers')
            .then(res => res.ok ? res.json() : Promise.reject('Failed to load user data'))
            .then(data => document.getElementById('totalUserCount').textContent = `${data}명`)
            .catch(error => console.error('Error fetching total user count:', error));
    }

    function getTotalMemberCount() {
        fetch('/admin/totalMembers')
            .then(res => res.ok ? res.json() : Promise.reject('Failed to load member data'))
            .then(data => document.getElementById('totalMembers').textContent = `${data}명`)
            .catch(error => console.error('Error fetching total member count:', error));
    }

    // 천 단위 콤마 포맷 적용
    function formatNumberWithComma(num) {
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function getTotalRevenue() {
        fetch('/admin/totalRevenue')
            .then(res => res.ok ? res.json() : Promise.reject('Failed to load revenue data'))
            .then(data => document.getElementById('totalRevenueAmount').textContent = `₩${formatNumberWithComma(data)}`)
            .catch(error => console.error('Error fetching revenue amount:', error));
    }

    function getDailyVisits() {
        fetch('/admin/dailyVisits')
            .then(res => res.ok ? res.json() : Promise.reject('Failed to load daily visits'))
            .then(data => document.getElementById('dailyVisits').textContent = `${data}명`)
            .catch(error => console.error('Error fetching daily visits:', error));
    }

    function getBestSellingProducts() {
        fetch('/admin/bestSellingProducts')
            .then(res => res.ok ? res.json() : Promise.reject('Failed to load top selling products'))
            .then(data => {
                const bestSellingProductList = document.getElementById('bestSellingProductList');
                bestSellingProductList.innerHTML = '';
                if (Array.isArray(data)) {
                    data.forEach((product, index) => {
                        const listItem = document.createElement('li');
                        listItem.textContent = `${index + 1}. ${product.productName}`;
                        bestSellingProductList.appendChild(listItem);
                    });
                } else {
                    bestSellingProductList.innerHTML = '<li>상품 데이터가 없습니다.</li>';
                }
            })
            .catch(error => {
                console.error('Error fetching best selling products:', error);
                document.getElementById('bestSellingProductList').innerHTML = '<li>오류</li>';
            });
    }

    function loadGenderData() {
        fetch('/admin/gender')
            .then(res => res.ok ? res.json() : Promise.reject('Failed to load gender data'))
            .then(data => {
                const labels = data.map(item => item.gender);
                const userCountData = data.map(item => item.count);
                const ctx = document.getElementById('genderChart').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: userCountData,
                            backgroundColor: ['#36A2EB', '#FF6384']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            })
            .catch(error => console.error('Error fetching gender data:', error));
    }

    function loadAgeData() {
        fetch('/admin/age')
            .then(res => res.ok ? res.json() : Promise.reject('Failed to load age data'))
            .then(data => {
                const labels = data.map(item => item.ageGroup);
                const ageData = data.map(item => item.userCount);
                const ctx = document.getElementById('ageDistributionChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: '사용자 수',
                            data: ageData,
                            backgroundColor: 'rgba(75, 192, 192, 0.6)',
                            borderColor: 'rgba(75, 192, 192, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            })
            .catch(error => console.error('Error fetching age data:', error));
    }
</script>

</body>
</html>
