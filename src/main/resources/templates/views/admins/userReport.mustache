<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>유저 신고 조회</title>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        /* 기본 테이블 스타일 */
        #userTable {
            font-size: 15px;
            color: #343a40;
            background-color: #f8f9fa;
        }

        #userTable th {
            background-color: #6c757d;
            color: white;
            text-align: center;
        }

        #userTable td {
            text-align: center;
            vertical-align: middle;
        }

        /* 페이징 버튼 스타일 */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 0.3em 1em;
            border-radius: 5px;
            color: #6c757d !important;
            border: 1px solid #dee2e6;
            margin: 2px;
            background-color: #ffffff;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background-color: #6c757d !important;
            color: #ffffff !important;
            border: 1px solid #6c757d;
        }

        /* 상태 아이콘 스타일 */
        .status-icon {
            width: 24px;
            height: 24px;
        }
    </style>
</head>
<body id="page-top">

{{>layout/admin/adminSidebar}}

<div id="content-wrapper" class="d-flex flex-column">
    <div id="content">
        <div class="container-fluid">
            <h1 class="h3 mb-2 text-gray-800">유저 신고 조회</h1><br>
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-secondary">유저 신고 목록</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="userTable" width="100%" cellspacing="0">
                            <thead>
                            <tr>
                                <th>ID</th>
                                <th>이름</th>
                                <th>신고 유형</th>
                                <th>신고 시간</th>
                                <th>상세보기</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{#userReport}}
                                <tr>
                                    <td>{{reportId}}</td>
                                    <td>{{receiverNickname}}</td>
                                    <td>{{category}}</td>
                                    <td class="report-time">{{createdAt}}</td>
                                    <td><a href="/admin/userReportList/{{reportId}}" class="btn btn-primary btn-sm">상세보기</a></td>
                                </tr>
                            {{/userReport}}
                            {{^userReport}}
                                <tr>
                                    <td colspan="5" class="text-center">신고된 사용자가 없습니다.</td>
                                </tr>
                            {{/userReport}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript Files Load -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function() {
        // 시간 포맷팅 함수
        function formatDate(dateString) {
            const date = new Date(dateString);
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            return `${year}-${month}-${day} ${hours}:${minutes}`;
        }

        // 시간 포맷팅 적용
        $('.report-time').each(function() {
            const originalTime = $(this).text();
            $(this).text(formatDate(originalTime));
        });

        // DataTable 초기화
        var table = $('#userTable').DataTable({
            "language": {
                "search": "검색:",
                "lengthMenu": "_MENU_ 개씩 보기",
                "info": "총 _TOTAL_명의 신고 중 _START_에서 _END_까지 표시",
                "paginate": {
                    "previous": "이전",
                    "next": "다음"
                }
            },
            "order": [[3, "desc"]],  // 신고 시간 기준 내림차순 정렬
            "pageLength": 5          // 페이지당 표시할 항목 수
        });

        // 전체 검색 필드를 특정 열로만 제한하는 커스텀 검색 기능 추가
        $.fn.dataTable.ext.search.push(
            function(settings, data, dataIndex) {
                var searchTerm = $('#userTable_filter input').val().toLowerCase();
                var senderNickname = data[1].toLowerCase();  // 신고자 닉네임 열
                var category = data[2].toLowerCase();         // 신고 유형 열

                // 신고자 닉네임 또는 신고 유형에 검색어가 포함된 경우 결과에 포함
                if (senderNickname.includes(searchTerm) || category.includes(searchTerm)) {
                    return true;
                }
                return false;
            }
        );

        // 검색 필드에 입력될 때마다 테이블 다시 그리기
        $('#userTable_filter input').on('keyup change', function() {
            table.draw();
        });
    });
</script>

</body>
</html>
