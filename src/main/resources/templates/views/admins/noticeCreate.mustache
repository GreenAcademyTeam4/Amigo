{{>layout/admin/adminSidebar}}

<div class="section section-properties">
    <div class="container">
        <div class="two_third first" style="height:auto">
            <div class="col-lg-12">
                <h2 class="font-weight-bold text-primary heading"><b>게시글 수정하기</b></h2>
                <hr/>
                <br><br>
                <div class="two_third first">
                    <form action="/notice/create" method="post" onsubmit="return validateTitle();">
                        <table class="table">
                            <tr>
                                <th width="20%" class="text-right">제목</th>
                                <td width="80%">
                                    <input type="text" name="title" size="150" class="input-sm" id="title">
                                </td>
                            </tr>
                            <tr>
                                <th width="20%" class="text-right">내용</th>
                                <td width="80%">
                                    <textarea rows="10" cols="150" name="content" id="content"></textarea>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" class="text-center">
                                    <button type="submit">글쓰기</button>
                                    <input type="button" value="취소" class="button" onclick="javascript:history.back()">
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function validateTitle() {
        const title = document.getElementById("title").value;

        if (title.length > 15) {
            alert("제목은 최대 15자까지 입력 가능합니다.");
            return false; // 폼 제출 방지
        }

        // 유효한 경우 폼 제출 계속 진행
        return true;
    }
</script>
