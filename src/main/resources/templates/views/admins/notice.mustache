{{>layout/admin/adminSidebar}}

<div class="container-fluid">
    <!-- Page Heading -->
    <h1 class="h3 mb-4 text-gray-800">공지사항 관리</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">공지사항 목록</h6>
            <button class="btn btn-primary btn-sm" onclick="location.href='/notice/add'">게시물 등록</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                    <tr>
                        <th><input type="checkbox" onclick="toggleAll(this)"></th>
                        <th>번호</th>
                        <th>제목</th>
                        <th>본문</th>
                        <th>작성일시</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#noticeList}}
                        <tr>
                            <td><input type="checkbox" name="selectNotice" value="{{id}}"></td>
                            <td>{{id}}</td>
                            <td>{{title}}</td>
                            <td>{{content}}</td>
                            <td>{{createdAt}}</td>
                        </tr>
                    {{/noticeList}}
                    {{^noticeList}}
                        <tr>
                            <td colspan="5">공지사항이 없습니다.</td>
                        </tr>
                    {{/noticeList}}
                    </tbody>
                </table>
                <div class="d-flex justify-content-between mt-3">
                    <div>
                        <button class="btn btn-sm btn-danger">선택삭제</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DataTables JavaScript dependencies -->
<script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
<script>
    $(document).ready(function() {
        $('#dataTable').DataTable();
    });


    function toggleAll(source) {
        const checkboxes = document.querySelectorAll('input[name="selectNotice"]');
        checkboxes.forEach(checkbox => checkbox.checked = source.checked);
    }
</script>