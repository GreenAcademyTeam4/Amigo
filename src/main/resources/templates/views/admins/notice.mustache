{{>layout/admin/adminSidebar}}

<style>
    /* DataTables 검색창 스타일 조정 */
    #dataTable_filter {
        float: right;
        margin-right: 20px;
    }

    #dataTable_filter label {
        font-weight: bold;
    }

    #dataTable_filter input {
        width: 200px; /* 검색 입력 필드의 너비 조정 */
        padding: 4px;
    }
</style>

<div class="container-fluid">
    <!-- 페이지 제목 -->
    <h1 class="h3 mb-4 text-gray-800">공지사항 관리</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">공지사항 목록</h6>
            <button class="btn btn-primary btn-sm" onclick="location.href='/admin/notice/create'">게시물 등록</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="95%" cellspacing="0" >
                    <thead class="thead-light">
                    <tr>
                        <th class="text-center" style="width: 5%;"><input type="checkbox" onclick="toggleAll(this)"></th>
                        <th class="text-center" style="width: 10%;">번호</th>
                        <th class="text-center" style="width: 50%;">제목</th>
                        <th class="text-center" style="width: 25%;">작성일시</th>
                        <th class="text-center" style="width: 10%;">상세보기</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#noticeList}}
                        <tr>
                            <td class="text-center align-middle"><input type="checkbox" name="selectNotice" value="{{id}}"></td>
                            <td class="text-center align-middle">{{id}}</td>
                            <td class="align-middle"><a href="/admin/notice/detail/{{id}}" class="text-dark font-weight-bold">{{title}}</a></td>
                            <td class="text-center align-middle">{{createdAt}}</td>
                            <td class="text-center align-middle"><a href="/admin/notice/detail/{{id}}" class="btn btn-primary btn-sm">상세보기</a></td>
                        </tr>
                    {{/noticeList}}
                    {{^noticeList}}
                        <tr>
                            <td colspan="5" class="text-center">공지사항이 없습니다.</td>
                        </tr>
                    {{/noticeList}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- DataTables JavaScript 의존성 -->
<script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>

<script>
    $(document).ready(function() {
         // DataTables 초기화
         var table = $('#dataTable').DataTable({
             dom: 'lfrtip', // 검색창 등 기본 UI 설정
             responsive: true, // 반응형 디자인 설정
             initComplete: function () {
                 // 열별 검색 기능 추가
                 this.api().columns().every(function () {
                     var that = this;

                     // 각 열의 필터 입력 필드 설정
                     $('input', this.header()).on('keyup change clear', function () {
                         if (that.search() !== this.value) {
                             that.search(this.value).draw();
                         }
                     });
                 });
             }
         });

         // 날짜 포맷팅 처리
         $('#dataTable tbody tr').each(function() {
             var dateCell = $(this).find('td:eq(3)'); // 작성일시가 있는 4번째 열 선택
             var dateStr = dateCell.text(); // 현재 텍스트 값 가져오기

             if (dateStr) {
                 var date = new Date(dateStr); // 문자열을 날짜 객체로 변환

                 // 원하는 날짜 포맷으로 변환 (예: YYYY/MM/DD HH:MM)
                 var formattedDate = date.toLocaleString('ko-KR', {
                     year: 'numeric',
                     month: '2-digit',
                     day: '2-digit',
                     hour: '2-digit',
                     minute: '2-digit',
                     hour12: false  // 24시간 형식
                 });

                 dateCell.text(formattedDate); // 포맷된 날짜로 셀 업데이트
             }
         });
     });

     function toggleAll(source) {
         const checkboxes = document.querySelectorAll('input[name="selectNotice"]');
         checkboxes.forEach(checkbox => checkbox.checked = source.checked);
     }
</script>
