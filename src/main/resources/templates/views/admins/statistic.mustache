{{>layout/admin/adminSidebar}}

<style>
    /* 기본 설정 */
    html, body { height: 100%; margin: 0; padding: 0; overflow-x: hidden; overflow-y: auto; font-family: Arial, sans-serif; background-color: #f4f6f9; }

    /* 전체 컨테이너 */
    .charts-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px;
        gap: 40px;
        box-sizing: border-box;
    }

    /* 통계 카드 섹션 */
    .user-revenue-wrapper {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        width: 100%;
        padding: 10px 0;
    }

    /* 통계 카드 */
    .user-count-container {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        padding: 20px;
        text-align: center;
        color: #34495e;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: fadeInSlide 0.6s ease-in-out;
        position: relative;
        overflow: hidden;
    }

    /* 카드 애니메이션 효과 */
    .user-count-container:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }

    /* 텍스트 스타일 */
    .user-count-container .text-xs { font-size: 14px; font-weight: bold; color: #6c757d; }
    .user-count-container .h5 { font-size: 26px; color: #2c3e50; margin-top: 8px; font-weight: 700; }

    /* 순위 카드 스타일 */
    .top-school-rank-container, .best-selling-products-container {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        padding: 20px;
        width: 100%;
        text-align: left;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: fadeInSlide 0.6s ease-in-out;
        position: relative;
    }

    .top-school-rank-container h6, .best-selling-products-container h6 {
        font-weight: bold;
        color: #34495e;
        margin-bottom: 15px;
        font-size: 18px;
        border-bottom: 2px solid #e0e0e0;
        padding-bottom: 5px;
    }

    /* 순위 목록 스타일 */
    .top-school-rank-container ol, .best-selling-products-container ol { padding: 0; list-style: none; margin: 0; }
    .top-school-rank-container li, .best-selling-products-container li {
        font-size: 16px;
        margin: 10px 0;
        color: #5a5a5a;
        display: flex;
        align-items: center;
    }

    /* 순위 강조 아이콘 */
    .top-school-rank-container li::before, .best-selling-products-container li::before {
        content: '🏅';
        font-size: 18px;
        margin-right: 8px;
        color: #ffd700; /* 금메달 색상 */
        animation: bounce 1s infinite alternate;
    }

    /* 차트 섹션 */
    .top-charts-wrapper {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        width: 100%;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    /* 차트 카드 */
    .chart-container {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        text-align: center;
        width: 48%;
        min-width: 300px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: fadeInSlide 0.6s ease-in-out;
    }

    .chart-container h6 {
        font-size: 18px;
        font-weight: 600;
        color: #34495e;
        margin-bottom: 15px;
    }

    /* 카드 애니메이션 효과 */
    .top-school-rank-container:hover, .best-selling-products-container:hover, .chart-container:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }

    /* 애니메이션 키프레임 */
    @keyframes fadeInSlide {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes bounce {
        from { transform: translateY(0); }
        to { transform: translateY(-3px); }
    }

    /* 스크롤바 스타일 */
    ::-webkit-scrollbar { height: 8px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #888; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #555; }
</style>

<!-- 전체 차트를 감싸는 컨테이너 -->
