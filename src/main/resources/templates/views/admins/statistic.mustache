        </div>
        <div class="chart-container">
            <h6>나이 분포</h6>
            <canvas id="ageDistributionChart" width="500" height="400"></canvas>
        </div>
    </div>
</div>






<script>
    // 전역 변수로 선언된 차트
    let chartByGender, ageDistributionChart;

    // DOMContentLoaded 이벤트 리스너 추가
    document.addEventListener('DOMContentLoaded', () => {
        getTotalUserCount();
        getTotalMemberCount();
        getTotalRevenue();
        getDailyVisits();
        getWithdrawnUserCount();
        getTotalPosts();
        getTotalComments();
        getBestSellingItem();
        loadGenderData();
        loadAgeData();
        getTopUserCountSchool();
    });


    // 페이지 로드 시 가장 유저가 많은 학교 순위 가져오기
    function getTopUserCountSchool() {
        fetch('/admin/topUserCountSchool')
            .then(response => response.json())
            .then(data => {
                const topSchoolList = document.getElementById('topSchoolList');
                topSchoolList.innerHTML = '';
                data.slice(0, 3).forEach((school, index) => {
                    const listItem = document.createElement('li');
                    listItem.textContent = `${index + 1}. ${school.schoolName} (${school.userCount}명)`;
                    topSchoolList.appendChild(listItem);
                });
            })
            .catch(error => {
                console.error('학교 순위 데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('topSchoolList').innerHTML = '<li>오류</li>';
            });
    }



    // 페이지 로드 시 전체 유저 수 가져오기
    function getTotalUserCount() {
        fetch('/admin/totalUsers')
            .then(response => {
                if (!response.ok) {
                    throw new Error('네트워크 응답에 문제가 있습니다.');
                }
                return response.json();
            })
            .then(data => {
                // 서버에서 받은 유저 수를 표시
                document.getElementById('totalUserCount').textContent = data + ' 명';
            })
            .catch(error => {
                console.error('데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('totalUserCount').textContent = '오류';
            });
    }

    // 페이지 로드 시 총 가입자 수 가져오기
    function getTotalMemberCount() {
        fetch('/admin/totalMembers')
            .then(response => {
                if (!response.ok) {
                    throw new Error('네트워크 응답에 문제가 있습니다.');
                }
                return response.json();
            })
            .then(data => {
                // 서버에서 받은 가입자 수를 표시
                document.getElementById('totalMembers').textContent = data + ' 명';
            })
            .catch(error => {
                console.error('총 가입자 데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('totalMembers').textContent = '오류';
            });
    }

    // 페이지 로드 시 전체 하루 방문자 수 가져오기
    function getDailyVisits() {
        fetch('/admin/dailyVisits')
            .then(response => {
                if (!response.ok) {
                    throw new Error('네트워크 응답에 문제가 있습니다.');
                }
                return response.json();
            })
            .then(data => {
                // 서버에서 받은 유저 수를 표시
                document.getElementById('dailyVisits').textContent = data + ' 명';
            })
            .catch(error => {
                console.error('데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('dailyVisits').textContent = '오류';
            });
    }
    // 페이지 로드 시 총 매출 가져오기
    function getTotalRevenue() {
        fetch('/admin/totalRevenue')
            .then(response => {
                if (!response.ok) {
                    throw new Error('네트워크 응답에 문제가 있습니다.');
                }
                return response.json();
            })
            .then(data => {
                // 서버에서 받은 총 매출을 표시
                document.getElementById('totalRevenueAmount').textContent = data + ' 원';
            })
            .catch(error => {
                console.error('총 매출 데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('totalRevenueAmount').textContent = '오류';
            });
    }
    // 페이지 로드 시 탈퇴 유저 수 가져오기
    function getWithdrawnUserCount() {
        fetch('/admin/withdrawnUserCount')
            .then(response => {
                if (!response.ok) {
                    throw new Error('네트워크 응답에 문제가 있습니다.');
                }
                return response.json();
            })
            .then(data => {
                // 서버에서 받은 총 매출을 표시
                document.getElementById('withdrawnUserCount').textContent = data + ' 명';
            })
            .catch(error => {
                console.error('총 매출 데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('withdrawnUserCount').textContent = '오류';
            });
    }
    // 페이지 로드 시 총 게시글 수 가져오기
    function getTotalPosts() {
        fetch('/admin/totalPosts')
            .then(response => {
                if (!response.ok) {
                    throw new Error('네트워크 응답에 문제가 있습니다.');
                }
                return response.json();
            })
            .then(data => {
                // 서버에서 받은 총 매출을 표시
                document.getElementById('totalPosts').textContent = data + ' 개';
            })
            .catch(error => {
                console.error('총 매출 데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('totalPosts').textContent = '오류';
            });
    }
    // 페이지 로드 시 총 댓글 수 가져오기
    function getTotalComments() {
        fetch('/admin/totalComments')
            .then(response => {
                if (!response.ok) {
                    throw new Error('네트워크 응답에 문제가 있습니다.');
                }
                return response.json();
            })
            .then(data => {
                // 서버에서 받은 총 매출을 표시
                document.getElementById('totalComments').textContent = data + ' 개';
            })
            .catch(error => {
                console.error('총 매출 데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('totalComments').textContent = '오류';
            });
    }

     // 페이지 로드 시 베스트 상품 가져오기
   function getBestSellingItem() {
    fetch('/admin/bestSellingItem')
        .then(response => {
            if (!response.ok) {
                throw new Error('네트워크 응답에 문제가 있습니다.');
            }
            return response.json(); // JSON 형태로 응답을 받음
        })
        .then(data => {
            if (Array.isArray(data)) {
                const productNames = data.map(item => item.productName).join(', ');
                document.getElementById('bestSellingItem').textContent = productNames;
            } else {
                document.getElementById('bestSellingItem').textContent = data.productName;
            }
        })
        .catch(error => {
            console.error('베스트 상품 데이터를 가져오는 중 문제가 발생했습니다:', error);
            document.getElementById('bestSellingItem').textContent = '오류';
        });
}


    //////
       document.addEventListener('DOMContentLoaded', () => {
        getBestSellingProducts();
        getBestSellingItem();
    });

    // 페이지 로드 시 가장 잘 팔린 상품 가져오기
    function getBestSellingProducts() {
        fetch('/admin/bestSellingProducts')
            .then(response => response.json())
            .then(data => {
                const productList = document.getElementById('bestSellingProductList');
                productList.innerHTML = '';
                data.forEach((product, index) => {
                    const listItem = document.createElement('li');
                    listItem.textContent = `${index + 1}. ${product.productName} (${product.totalSold}개 판매)`;
                    productList.appendChild(listItem);
                });
            })
            .catch(error => {
                console.error('가장 잘 팔린 상품 데이터를 가져오는 중 문제가 발생했습니다:', error);
                document.getElementById('bestSellingProductList').innerHTML = '<li>오류</li>';
            });
    }







    // chart.js


    // 성별 사용자 수 차트
    function loadGenderData() {
        fetch('/admin/gender')
            .then(response => response.json())
            .then(data => {
                if (!data || data.length === 0) {
                    throw new Error('성별 데이터가 비어 있습니다.');
                }

                const labels = data.map(item => item.gender);
                const userCountData = data.map(item => item.count);

                const ctx = document.getElementById('myChart');
                if (!ctx) {
                    throw new Error('myChart 캔버스를 찾을 수 없습니다.');
                }

                // 이전 차트가 존재하면 삭제
                if (chartByGender) {
                    chartByGender.destroy();
                }

                // 새로운 차트 생성
                chartByGender = new Chart(ctx.getContext('2d'), {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: '사용자 수',
                            data: userCountData,
                            backgroundColor: [
                                'rgba(54, 162, 235, 1)', // 여
                                'rgba(255, 99, 132, 1)', // 남
                                'rgba(75, 192, 192, 1)' // 설정 안 함
                            ],
                            borderColor: [
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 99, 132, 1)',
                                'rgba(75, 192, 192, 1)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: false,
                        plugins: {
                            legend: {
                                position: 'top',
                            },
                            title: {
                                display: true,
                                text: '남/여 사용자 수'
                            },
                            tooltip: {
                                enabled: true
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('성별 데이터 로드 중 오류 발생:', error));
    }

    // 나이 분포 차트
    function loadAgeData() {
        fetch('/admin/age')
            .then(response => response.json())
            .then(data => {
                if (!data || data.length === 0) {
                    throw new Error('나이 데이터가 비어 있습니다.');
                }

                const labels = data.map(item => `${item.ageGroup}`);
                const userData = data.map(item => item.userCount);
                console.log(' userData 들어오나:', userData);
                console.log('데이터 확인:', data);

                const ctx = document.getElementById('ageDistributionChart');
                if (!ctx) {
                    throw new Error('ageDistributionChart 캔버스를 찾을 수 없습니다.');
                }

                // 이전 차트가 존재하면 삭제
                if (ageDistributionChart) {
                    ageDistributionChart.destroy();
                }

                ageDistributionChart = new Chart(ctx.getContext('2d'), {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: '나이 분포',
                            data: userData,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(54, 162, 235, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(153, 102, 255, 0.2)',
                                'rgba(255, 159, 64, 0.2)',
                                'rgba(201, 203, 207, 0.2)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(255, 159, 64, 1)',
                                'rgba(201, 203, 207, 1)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: false,
                        plugins: {
                            legend: {
                                position: 'top',
                            },
                            title: {
                                display: true,
                                text: '나이 분포'
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('나이 데이터 로드 중 오류 발생:', error));
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
