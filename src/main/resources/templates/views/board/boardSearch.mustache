<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/board/board.css">
    <title>게시글 목록</title>
</head>
<body>
<div class="board-container">

    <div class="board-header">
        <h2>학교 번호: {{schoolId}} 게시글 목록 (검색 결과)</h2>
    </div>

    <div class="content mt-5">
        <!-- 글쓰기 버튼과 검색창 -->
        <div class="search-bar mb-4">
            <form id="searchForm" class="input-group" style="max-width: 600px;">
                <select name="searchType" id="searchType" class="form-select" style="max-width: 100px;" required>
                    <option value="title" {{#isTitleSelected}}selected{{/isTitleSelected}}>제목</option>
                    <option value="nickname" {{#isNicknameSelected}}selected{{/isNicknameSelected}}>닉네임</option>
                    <option value="titleContent" {{#isTitleContentSelected}}selected{{/isTitleContentSelected}}>제목 + 내용</option>
                </select>
                <input type="search" name="keyword" id="keyword" class="form-control" placeholder="검색어를 입력하세요" value="{{keyword}}">
                <button class="btn-search" type="button" id="searchButton">
                    <img src="https://cdn-icons-png.flaticon.com/512/622/622669.png" alt="검색 아이콘" style="width: 20px;">
                </button>
            </form>
        </div>

        <!-- 글쓰기 버튼 -->
        <div class="action-buttons mb-3">
            <a class="btn btn-primary" onclick="screenChanger('/board/form')">글쓰기</a>
            <a class="btn btn-secondary ml-2" onclick="screenChanger('/board/multiBoard')">게시판 여러개 띄우기</a>
        </div>

        <!-- 게시글 목록 테이블 -->
        <div class="board-table-container">
            <table class="table table-bordered mt-4">
                <thead class="thead-dark">
                <tr>
                    <th>제목</th>
                    <th>작성자</th>
                    <th>조회수</th>
                    <th>좋아요</th>
                    <th>작성일자</th>
                </tr>
                </thead>
                <tbody>
                {{#boardList}}
                    <tr>
                        <td><a onclick="screenChanger('/board/detail/{{id}}')">{{title}}</a></td>
                        <td>{{nickname}}</td>
                        <td>{{viewCount}}</td>
                        <td>{{likes}}</td>
                        <td>{{createdAtFormat}}</td>
                    </tr>
                {{/boardList}}
                {{^boardList}}
                    <tr>
                        <td colspan="5" class="text-center">게시글이 없습니다.</td>
                    </tr>
                {{/boardList}}
                </tbody>
            </table>
        </div>

        <!-- 페이지네이션 버튼 -->
        <div class="pagination-wrapper">
            <div id="pagination-container"></div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/board/boardMulti.js"></script>
<script src="/js/board/boardList.js"></script>

<script>
    // Pagination 데이터 저장 객체
    window.paginationData = {
        totalPages: {{totalPages}},
        currentPage: {{currentPage}},
        searchType: "{{searchType}}",
        keyword: "{{keyword}}"
    };

    // 검색 버튼 클릭 이벤트
    $(document).on('click', '#searchButton', function () {
        const searchType = $('#searchType').val();
        const keyword = $('#keyword').val().trim();

        // if (!keyword) {
        //     alert('검색어를 입력하세요!');
        //     return;
        // }

        // AJAX를 통해 검색 요청
        $.ajax({
            url: '/board/search',
            type: 'GET',
            data: {
                searchType: searchType,
                keyword: keyword,
                page: 1,
                size: 4
            },
            success: function (html) {
                $('.board-container').html(html);

                // 검색 데이터 갱신
                window.paginationData.searchType = searchType;
                window.paginationData.keyword = keyword;
                window.paginationData.currentPage = 1;

                // 페이지네이션 업데이트
                updatePagination(1);
            },
            error: function (xhr, status, error) {
                console.error('검색 요청 중 오류 발생:', error);
            }
        });
    });

    // 페이지네이션 처리 함수
    function fetchBoardPage(page) {
        const { searchType, keyword } = window.paginationData;

        // AJAX를 통해 페이지네이션 요청
        $.ajax({
            url: '/board/search',
            type: 'GET',
            data: {
                searchType: searchType,
                keyword: keyword,
                page: page,
                size: 4
            },
            success: function (html) {
                $('.board-container').html(html);

                // 현재 페이지 업데이트
                window.paginationData.currentPage = page;
                updatePagination(page);
            },
            error: function (xhr, status, error) {
                console.error('페이지 로딩 중 오류 발생:', error);
            }
        });
    }

    // 페이지네이션 버튼 업데이트
    function updatePagination(currentPage) {
        const paginationContainer = $('#pagination-container');
        paginationContainer.empty();

        const totalPages = window.paginationData.totalPages;

        for (let i = 1; i <= totalPages; i++) {
            const button = $('<button>')
                    .text(i)
                    .addClass('page-button')
                    .toggleClass('active', i === currentPage)
                    .on('click', function () {
                        fetchBoardPage(i);
                    });

            paginationContainer.append(button);
        }
    }

    // 초기화
    $(document).ready(function () {
        updatePagination(window.paginationData.currentPage);
    });
</script>

</body>
</html>
