<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>검색 결과</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5">
    <h1>학교 번호: {{schoolId}} 게시글 검색 결과</h1>

    <form action="/board/search" method="GET" class="form-inline mb-4">
        <input class="form-control mr-sm-2" type="search" name="keyword" placeholder="검색어 입력" value="{{keyword}}" aria-label="Search">
        <button class="btn btn-outline-success my-2 my-sm-0" type="submit">검색</button>
    </form>

    <table class="table table-bordered mt-4">
        <thead class="thead-dark">
        <tr>
            <th>제목</th>
            <th>작성자</th>
            <th>조회수</th>
            <th>좋아요</th>
            <th>작성일자</th>
        </tr>
        </thead>
        <tbody>
        {{#boardList}}
            <tr>
                <td> <a href="/board/detail/{{id}}">{{title}}</a> </td>
                <td>{{nickname}}</td>
                <td>{{viewCount}}</td>
                <td>{{likes}}</td>
                <td>{{createdAtFormat}}</td>
            </tr>
        {{/boardList}}
        {{^boardList}}
            <tr>
                <td colspan="5" class="text-center">검색된 게시글이 없습니다.</td>
            </tr>
        {{/boardList}}
        </tbody>
    </table>

    <!-- 페이지 네비게이션 -->
    <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center" id="pagination">
            <!-- JavaScript로 페이지 번호 생성 -->
        </ul>
    </nav>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // totalPages는 서버에서 Mustache로 전달된 변수
        const totalPages = {{totalPages}};
        const paginationContainer = document.getElementById('pagination');
        const currentPage = {{currentPage}} + 1; // 현재 페이지는 서버에서 전달받은 값 사용

        for (let i = 1; i <= totalPages; i++) {
            let li = document.createElement('li');
            li.className = 'page-item';

            // 현재 페이지를 활성화 상태로 표시
            if (i === currentPage) {
                li.classList.add('active');
            }

            let a = document.createElement('a');
            a.className = 'page-link';
            a.href = `?page=${i - 1}&size=4&keyword=${encodeURIComponent('{{keyword}}')}`;
            a.textContent = i;

            li.appendChild(a);
            paginationContainer.appendChild(li);
        }
    });
</script>

</body>
</html>
