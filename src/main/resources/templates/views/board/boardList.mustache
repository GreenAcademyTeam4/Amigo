<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/board/board.css">
    <title>게시글 목록</title>  
</head>

<div class="board-container">
    <div class="head-title">
         학교 번호: {{schoolId}} 게시글 목록
    </div>
  

    <td>
        <a href="/board/form">글쓰기</a>
    </td>

    <td>
        <a href="/board/multiBoard">게시판 여러개 띄우기</a>
    </td>


    <table class="table table-bordered mt-4">
        <thead class="thead-dark">
        <tr>
            <th>제목</th>
            <th>내용</th>
            <th>작성자</th>
            <th>조회수</th>
            <th>좋아요</th>
            <th>작성일자</th>
        </tr>
        </thead>
        <tbody>
        {{#boardList}}
        <div>
            <tr>

                <td> <a href="/board/detail/{{id}}">{{title}}</a> </td>
                <td>{{contentLocation}}</td>
                <td>{{nickname}}</td>
                <td>{{viewCount}}</td>
                <td>{{likes}}</td>
                <td>{{createdAtFormat}}</td>
            </tr>
        </div>
        {{/boardList}}
        {{^boardList}}
            <tr>
                <td colspan="6" class="text-center">게시글이 없습니다.</td>
            </tr>
        {{/boardList}}
        </tbody>
    </table>
</div>

