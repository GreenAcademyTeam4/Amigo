<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/board/board.css">
    <title>게시글 목록</title>
</head>
<body>

<div class="board-container">
    <div class="head-title">
        학교 번호: {{schoolId}} 게시글 목록
    </div>
</div>

<div class="container mt-5">
    <h1>학교 번호: {{schoolId}} 게시글 목록</h1>

    <!-- 글쓰기 버튼과 검색창 -->
    <div class="mb-4">
        <form id="searchForm" class="input-group" style="max-width: 600px;">
            <!-- 검색 기준 선택 -->
            <select name="searchType" class="form-select" style="max-width: 100px;" required>
                <option value="title">제목</option>
                <option value="nickname">닉네임</option>
                <option value="titleContent">제목 + 내용</option>
            </select>
            <!-- 검색어 입력 필드 -->
            <input type="search" name="keyword" class="form-control" placeholder="검색어를 입력하세요" aria-label="Search">
            <!-- 검색 버튼 -->
            <button class="btn btn-outline-secondary" type="submit">
                <img src="https://cdn-icons-png.flaticon.com/512/622/622669.png" alt="검색 아이콘" style="width: 20px;">
            </button>
            <!-- 닫기 버튼 -->
            <button class="btn btn-outline-secondary ml-2" type="button" onclick="loadList()">닫기</button>
        </form>

        <!-- 검색 결과를 표시할 영역 -->
        <div id="searchResults"></div>
    </div>

    <!-- 글쓰기 버튼 -->
    <div>
        <a onclick="screenChanger('/board/form')" class="btn btn-primary">글쓰기 HEART</a>
        <a class="btn btn-secondary ml-2" onclick="screenChanger('/board/multiBoard')">게시판 여러개 띄우기</a>
    </div>

    <!-- 게시글 목록 테이블 -->
    <table class="table table-bordered mt-4">
        <thead class="thead-dark">
        <tr>
            <th>제목</th>
            <th>작성자</th>
            <th>조회수</th>
            <th>좋아요</th>
            <th>작성일자</th>
        </tr>
        </thead>
        <tbody>

        {{#boardList}}
            <tr>
                <td><a onclick="screenChanger('/board/detail/{{id}}')">{{title}}</a></td>
                <td>{{nickname}}</td>
                <td>{{viewCount}}</td>
                <td>{{likes}}</td>
                <td>{{createdAtFormat}}</td>
            </tr>
        {{/boardList}}
        {{^boardList}}
            <tr>
                <td colspan="5" class="text-center">게시글이 없습니다.</td>
            </tr>
        {{/boardList}}
        </tbody>
    </table>

    <!-- 페이지 네비게이션 -->
    <nav aria-label="Page navigation example" id="pagination-container">
        <!-- 페이지네이션 버튼이 JavaScript로 직접 생성됩니다 -->
    </nav>

    <script>
        // 서버에서 렌더링된 페이지 수를 받아서 JavaScript로 전달
        const totalPages = {{totalPages}};
    </script>
</div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- 지금 이거 작동 안됨 페이징 처리 작동 X -->
<script src="/js/board/boardHeartList.js"></script>
<script src="/js/board/boardMulti.js"></script>

</body>
</html>
