<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/board/board.css">.
    <title>게시글 목록</title>
</head>
<body>
<div class="board-container">
    <div class="board-header">
        <h2>학교 번호: {{schoolId}} 게시글 목록</h2>
    </div>

    <div class="content mt-5">
        <!-- 글쓰기 버튼과 검색창 -->
        <div class="search-bar mb-4">
            <form id="searchForm" class="input-group" style="max-width: 600px;">
                <select name="searchType" id="searchType" class="form-select" style="max-width: 100px;" required>
                    <option value="title">제목</option>
                    <option value="nickname">닉네임</option>
                    <option value="titleContent">제목 + 내용</option>
                </select>
                <input type="search" name="keyword" id="keyword" class="form-control" placeholder="검색어를 입력하세요" aria-label="Search">
                <button class="btn-search" type="button" id="searchButton">
                    <img src="https://cdn-icons-png.flaticon.com/512/622/622669.png" alt="검색 아이콘" style="width: 20px;">
                </button>
            </form>
        </div>

        <!-- 글쓰기 버튼 -->
        <div class="action-buttons mb-3">
            <a class="btn btn-primary" onclick="screenChanger('/board/form')">글쓰기</a>
            <a class="btn btn-secondary ml-2" onclick="screenChanger('/board/multiBoard')">게시판 여러개 띄우기</a>
        </div>

        <!-- 게시글 목록 테이블 -->
        <div class="board-table-container">
            <table class="table table-bordered mt-4">
                <thead class="thead-dark">
                <tr>
                    <th>제목</th>
                    <th>작성자</th>
                    <th>조회수</th>
                    <th>좋아요</th>
                    <th>작성일자</th>
                </tr>
                </thead>
                <tbody>
                {{#boardList}}
                    <tr>
                        <td><a onclick="screenChanger('/board/detail/{{id}}')">{{title}}</a></td>
                        <td>{{nickname}}</td>
                        <td>{{viewCount}}</td>
                        <td>{{likes}}</td>
                        <td>{{createdAtFormat}}</td>
                    </tr>
                {{/boardList}}
                {{^boardList}}
                    <tr>
                        <td colspan="5" class="text-center">게시글이 없습니다.</td>
                    </tr>
                {{/boardList}}
                </tbody>
            </table>
        </div>

        <!-- 페이지네이션 버튼 -->
        <div class="pagination-wrapper">
            <div id="pagination-container"></div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/board/boardMulti.js"></script>
<script src="/js/board/boardList.js"></script>

<script>
    // Pagination 데이터 저장 객체
window.paginationData = {
    totalPages: {{totalPages}}, // Mustache에서 받아오는 totalPages 값
    currentPage: {{currentPage}} // Mustache에서 받아오는 currentPage 값
};

function fetchBoardPage(page) {
    console.log("Fetching board page:", page);
    fetch(`/board/newHeart?offset=${page}&size=4`)
        .then(response => response.text())
        .then(html => {
            document.querySelector('.board-container').innerHTML = html;

            // 현재 페이지 업데이트
            window.paginationData.currentPage = page;
            updatePagination(page);
        })
        .catch(error => console.error('페이지 로딩 중 오류 발생:', error));
}

function updatePagination(currentPage) {
    const paginationContainer = document.getElementById('pagination-container');
    paginationContainer.innerHTML = '';

    // Total Pages 가져오기
    const totalPages = window.paginationData.totalPages;

    for (let i = 0; i < totalPages; i++) {
        const button = document.createElement('button');
        button.textContent = i + 1;
        button.classList.add('page-button');
        console.log('버튼 생성');

        if (i === currentPage - 1) {
            button.classList.add('active');
        }

        button.addEventListener('click', () => fetchBoardPage(i + 1));
        paginationContainer.appendChild(button);
    }
}

$(document).ready(function () {
    console.log('페이지네이션 초기화');
    console.log(
        "Total Pages:",
        window.paginationData.totalPages,
        "Initial Page:",
        window.paginationData.currentPage
    );

    // 초기 페이지네이션 세팅
    updatePagination(window.paginationData.currentPage);
});

</script>

</body>
</html>