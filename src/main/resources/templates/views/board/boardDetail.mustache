<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>게시글 상세보기</title>
    <link rel="stylesheet" type="text/css" href="/css/board/boardDetail.css">

</head>

<body>
<div class="container">
    <div class="content-wrapper">
        <!-- Main Content -->
        <div class="main-content">
            <!-- 상단 버튼 섹션 -->
            <div class="top-buttons d-flex justify-content-between mb-3">
                <a class="btn btn-primary" onclick="screenChanger('/board/list')">목록으로 돌아가기</a>
                <div>
                    {{#isAuthor}}
                        <button type="button" class="btn btn-danger" onclick="screenDelete('/board/delete/{{board.id}}')">게시글 삭제</button>
                        <button onclick="screenChanger('/board/update/{{board.id}}')" class="btn btn-secondary">게시글 수정하기</button>
                    {{/isAuthor}}
                    {{^isAuthor}}
                        <div class="report-section text-center mt-3">
                            <button id="report-button" class="btn btn-warning" onclick="reportPost({{board.id}})">신고하기</button>
                        </div>
                    {{/isAuthor}}
                </div>
            </div>

            <!-- 게시글 본문 -->
            <div class="board-card">
                <h1 class="board-title">{{board.title}}</h1>
                <p class="board-meta">
                    <strong>닉네임:</strong> {{board.nickname}} |
                    <strong>작성일자:</strong> {{board.createdAtFormat}}
                </p>

                <div class="board-content">
                    {{#board.image}}
                        <div class="board-image">
                            <img src="data:image/jpeg;base64,{{board.image}}" alt="Board Image">
                        </div>
                    {{/board.image}}

                    <p>{{board.contentLocation}}</p>
                </div>
            </div>

            <!-- 좋아요 섹션 -->
            <div class="like-section">
                <img id="like-icon" class="like-icon {{#hasLiked}}liked{{/hasLiked}}" 
                     src="{{#hasLiked}}/image/board/full.png{{/hasLiked}}{{^hasLiked}}/image/board/empty.png{{/hasLiked}}" 
                     alt="좋아요 아이콘" onclick="toggleLike()">
                <span><strong>좋아요:</strong> <span id="like-count">{{board.likes}}</span></span>
            </div>

            <!-- 댓글 목록 -->
            <div class="comments">
                <h3>댓글 목록</h3>
                {{#comment}}
                <div class="comment" id="comment-{{id}}">
                    <div class="comment-header">
                        <p><strong>작성자:</strong> {{nickname}}</p>
                        <p><small>작성일자: {{createdAtFormat}}</small></p>
                    </div>
                    <div class="comment-body">
                        <p id="content-{{id}}">{{content}}</p>
                    </div>

                    <!-- 본인 댓글일 경우 수정/삭제 버튼 표시 -->
                    {{#isCommentAuthor}}
                    <div class="comment-actions">
                        <button onclick="confirmDeleteComment({{id}})" class="btn btn-danger btn-sm">🗑</button>
                        <button onclick="showEditForm({{id}})" class="btn btn-link btn-sm">수정</button>
                    </div>
                    <div id="edit-form-{{id}}" style="display: none; margin-top: 10px;">
                        <textarea id="edit-content-{{id}}" rows="3" class="form-control">{{content}}</textarea>
                        <button onclick="updateComment({{id}})" class="btn btn-success mt-2">수정 완료</button>
                    </div>
                    {{/isCommentAuthor}}
                </div>
                <hr>
                {{/comment}}
                {{^comment}}
                <p>댓글이 없습니다.</p>
                {{/comment}}
            </div>

            <!-- 댓글 작성 폼 -->
            <div class="comment-form">
                <form id="comment-form" onsubmit="submitComment(event, {{board.id}});">
                    <input type="hidden" name="boardId" value="{{board.id}}">
                    <div class="form-group">
                        <label for="commentContent"></label>
                        <textarea class="form-control" id="commentContent" name="content" rows="3" required></textarea>
                    </div>
                    <div class="form-footer text-right">
                        <button type="submit" class="btn btn-success">댓글 등록</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</body>

<script>

   // 좋아요 버튼 클릭 시 작동하는 함수
function toggleLike() {
    const boardId = {{board.id}}; // Mustache에서 board.id 값 가져옴
    const likeIcon = document.getElementById('like-icon');
    const likeCountSpan = document.getElementById('like-count');

    if (!likeIcon || !likeCountSpan) {
        console.error('Like icon or like count span not found in the DOM.');
        return;
    }

    const url = `/board/like/${boardId}`;
    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // 서버에서 반환된 좋아요 상태와 개수로 UI 업데이트
                likeCountSpan.textContent = data.likeCount;
                if (data.hasLiked) {
                    likeIcon.classList.add('liked');
                    likeIcon.src = '/image/board/full.png'; // 좋아요 활성화 아이콘 변경
                } else {
                    likeIcon.classList.remove('liked');
                    likeIcon.src = '/image/board/empty.png'; // 좋아요 비활성화 아이콘 변경
                }
            } else {
                console.error('좋아요 상태 변경 실패');
            }
        })
        .catch(error => {
            console.error('좋아요 상태 변경 중 오류 발생:', error);
        });
}

     // 댓글 "수정" 버튼 클릭 시 작동하는 함수
function showEditForm(commentId) {
    const editForm = document.getElementById(`edit-form-${commentId}`);
    const contentElement = document.getElementById(`content-${commentId}`);

    if (!editForm || !contentElement) {
        console.error("Edit form or content element not found for comment ID:", commentId);
        return;
    }

    editForm.style.display = 'block';
    contentElement.style.display = 'none';
}

// 댓글 "수정 완료" 버튼 클릭 시 비동기 처리 함수
function updateComment(commentId) {
    const updatedContent = document.getElementById(`edit-content-${commentId}`).value;

    if (!updatedContent.trim()) {
        alert("댓글 내용을 입력해주세요.");
        return;
    }

    fetch(`/board/reply/update/${commentId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ content: updatedContent })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // 댓글 내용을 업데이트
                document.getElementById(`content-${commentId}`).innerText = updatedContent;
                document.getElementById(`edit-form-${commentId}`).style.display = 'none';
                document.getElementById(`content-${commentId}`).style.display = 'block';
                alert('댓글이 성공적으로 수정되었습니다.');
            } else {
                console.error('댓글 수정 실패:', data.error);
                alert('댓글 수정에 실패했습니다.');
            }
        })
        .catch(error => {
            console.error('댓글 수정 중 오류 발생:', error);
            alert('서버 오류로 댓글 수정에 실패했습니다.');
        });
}

// 댓글 삭제 확인 창 호출
function confirmDeleteComment(commentId) {
    const userConfirmed = confirm("댓글을 삭제하시겠습니까?");
    if (userConfirmed) {
        deleteComment(commentId); // 확인 시 삭제 처리
    }
}

// 댓글 삭제 비동기 처리 함수
function deleteComment(commentId) {
    const commentElement = document.getElementById(`comment-${commentId}`);

    if (!commentElement) {
        console.error('Comment element not found for ID:', commentId);
        return;
    }

    fetch(`/board/reply/delete/${commentId}`, {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json'
        }
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                commentElement.remove(); // 댓글 요소 제거
                alert('댓글이 성공적으로 삭제되었습니다.');
            } else {
                console.error('댓글 삭제 실패:', data.error);
                alert('댓글 삭제에 실패했습니다.');
            }
        })
        .catch(error => {
            console.error('댓글 삭제 중 오류 발생:', error);
            alert('서버 오류로 댓글 삭제에 실패했습니다.');
        });
}

</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/board/boardMulti.js"></script>

</html>
