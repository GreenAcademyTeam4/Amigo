<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/board/board.css">
    <title>게시글 목록</title>
</head>
<body>
<div class="board-container">
    <div class="head-title">
        학교 번호: {{schoolId}} 게시글 목록
    </div>
</div>

<div class="container mt-5">
    <h1>학교 번호: {{schoolId}} 게시글 목록</h1>

    <!-- 글쓰기 버튼과 검색창 -->
    <div class="mb-4">
        <form action="/board/search" method="get" class="input-group" style="max-width: 600px;">
            <!-- 검색 기준 선택 -->
            <select name="searchType" class="form-select" style="max-width: 100px;" required>
                <option value="title">제목</option>
                <option value="nickname">닉네임</option>
                <option value="titleContent">제목 + 내용</option>
            </select>
            <!-- 검색어 입력 필드 -->
            <input type="search" name="keyword" class="form-control" placeholder="검색어를 입력하세요" aria-label="Search">
            <!-- 검색 버튼 -->
            <button class="btn btn-outline-secondary" type="submit">
                <img src="https://cdn-icons-png.flaticon.com/512/622/622669.png" alt="검색 아이콘" style="width: 20px;">
            </button>
            <!-- 닫기 버튼 -->
            <button class="btn btn-outline-secondary ml-2" type="button" onclick="window.location.href='/board/list';">닫기</button>
        </form>
    </div>

    <!-- 글쓰기 버튼 -->
    <div>
        <a class="btn btn-primary" onclick="screenChanger('/board/form')">글쓰기</a>
        <a class="btn btn-secondary ml-2" onclick="screenChanger('/board/multiBoard')" >게시판 여러개 띄우기</a>
    </div>

    <!-- 게시글 목록 테이블 -->
    <table class="table table-bordered mt-4">
        <thead class="thead-dark">
        <tr>
            <th>제목</th>
            <th>작성자</th>
            <th>조회수</th>
            <th>좋아요</th>
            <th>작성일자</th>
        </tr>
        </thead>
        <tbody>
        {{#boardList}}
            <tr>
                <td><a onclick="screenChanger('/board/detail/{{id}}')">{{title}}</a></td>
                <td>{{nickname}}</td>
                <td>{{viewCount}}</td>
                <td>{{likes}}</td>
                <td>{{createdAtFormat}}</td>
            </tr>
        {{/boardList}}
        {{^boardList}}
            <tr>
                <td colspan="5" class="text-center">게시글이 없습니다.</td>
            </tr>
        {{/boardList}}
        </tbody>
    </table>

    <!-- 페이지 네비게이션 -->
    <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center" id="pagination">
            <!-- JavaScript로 페이지 번호 생성 -->
        </ul>
    </nav>
</div>

<script>
    const totalPages = {{totalPages}};
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="/js/board/boardMulti.js"></script>

<!-- 지금 이거 작동 안됨 페이징 처리 작동 X -->
<script src="/js/board/boardCommentList.js"></script>

</body>
</html>
