<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>게시글 수정</title>
    <script type="text/javascript" src="/smarteditor/js/HuskyEZCreator.js" charset="utf-8"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 0; /* Remove default margin */
        }

        #boardForm {
            width: 100%;
            margin: 0;
            padding: 0;
            background: none;
            box-sizing: border-box;
        }

        #boardForm h3 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            text-align: center;
        }

        #boardForm input[type="text"],
        #boardForm textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #ced4da;
            border-radius: 5px;
            font-size: 1rem;
            box-sizing: border-box;
        }

        /* Adjust the smart editor container */
        #editorText {
            width: 100%;
            height: 500px; /* Adjust the height as needed */
            box-sizing: border-box;
        }

        .form-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
        }

        #cancelButton, #submitButton {
            background-color: #007bff;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        #cancelButton:hover, #submitButton:hover {
            background-color: #0056b3;
        }

        /* 스마트 에디터의 iframe을 직접 스타일링 */
        iframe {
            width: 100%;
            max-width: 1100px;
            height: 500px;
            box-sizing: border-box;
        }


    </style>


</head>
<body>
<form id="boardForm" action="/board/update/{{board.id}}" method="post">
    <h3>게시글 수정</h3>
    <div>
        <label for="title">제목</label>
        <input type="text" name="title" id="title" value="{{board.title}}" required>
        <input type="hidden" name="school_id" id="school_id" value="{{schoolId}}">
        <input type="hidden" name="user_id" id="user_id" value="{{userId}}">
    </div>

    <div>
        <label for="editorText">내용</label>
        <textarea name="content_location" id="editorText" rows="20" placeholder="내용을 입력해주세요">{{board.contentLocation}}</textarea>
    </div>

    <div class="form-footer">
        <button type="button" id="submitButton" onclick="modifyPost('/board/update/{{board.id}}', 'boardForm')">수정 완료</button>
        <button type="button" id="cancelButton" onclick="screenChanger('/board/list')">목록으로 돌아가기</button>
    </div>
</form>

<script>
    window.oEditors = [];

    function smartEditor() {
        nhn.husky.EZCreator.createInIFrame({
            oAppRef: oEditors,
            elPlaceHolder: "editorText", // 에디터가 삽입될 요소 ID
            sSkinURI: "/smarteditor/SmartEditor2Skin.html",
            fCreator: "createSEditor2",
            // 에디터 로드 후 크기 설정
            fOnAppLoad: function () {
                const iframe = document.querySelector('iframe'); // iframe을 선택
                if (iframe) {
                    iframe.style.width = "100%"; // 부모 컨테이너에 맞춤
                    iframe.style.maxWidth = "1100px"; // 최대 너비 설정
                    iframe.style.height = "500px"; // 고정 높이 설정
                }
            }
        });
    }

    $(document).ready(function () {
        smartEditor();
    });

    function modifyPost(url, formId) {
        // 에디터 내용 업데이트
        oEditors.getById["editorText"].exec("UPDATE_CONTENTS_FIELD", []);
        const form = document.getElementById(formId);

        const content = $("#editorText").val();
        if (!content.trim()) {
            alert("내용을 입력해주세요.");
            oEditors.getById["editorText"].exec("FOCUS");
            return;
        }

        // AJAX를 통해 폼 데이터 전송
        $.ajax({
            url: url,
            type: "POST",
            data: $(form).serialize(),
            success: function (response) {
                alert("게시글이 성공적으로 수정되었습니다.");
                screenChanger('/board/list');
            },
            error: function (error) {
                console.error("게시글 수정 중 오류 발생:", error);
                alert("게시글 수정에 실패했습니다.");
            }
        });
    }

</script>
</body>
</html>
