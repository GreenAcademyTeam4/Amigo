<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>인벤토리</title>
    <link rel="stylesheet" type="text/css" href="/css/mypage/inventory.css">
</head>


    <div class="container">
     <div class="top-blanck">
     <span class="chage-info">
          <div class="info-href" id="my-inventory">인벤토리</div> 
          <a href="/my-page/friend-list">친구 관리</a> 
          <a href="javascript:void(0)" onClick="javascript:goPost()">포인트 충전 내역</a> 
          <a href="/my-page/pwdcheck">비밀번호 변경</a>
    </span>
    </div>
        <div class="title">인벤토리</div>
        <div class="section">
            <div class="section-title">현재 착용중인 아바타</div>
            <div class="item">헤드: {{#nowAvatar.head}}{{.}}{{/nowAvatar.head}}{{^nowAvatar.head}}N/A{{/nowAvatar.head}}</div>
            <div class="item">상의: {{#nowAvatar.top}}{{.}}{{/nowAvatar.top}}{{^nowAvatar.top}}N/A{{/nowAvatar.top}}</div>
            <div class="item">하의: {{#nowAvatar.bottom}}{{.}}{{/nowAvatar.bottom}}{{^nowAvatar.bottom}}N/A{{/nowAvatar.bottom}}</div>
            <div class="item">신발: {{#nowAvatar.shoes}}{{.}}{{/nowAvatar.shoes}}{{^nowAvatar.shoes}}N/A{{/nowAvatar.shoes}}</div>
        </div>

        <div class="section">
            <div class="section-title">내가 보유중인 아바타</div>

            <div class="subsection">
                <div class="subsection-title">머리</div>
                <ul class="inventory-list">
                    {{#headInventory}}
                        <li class="inventory-item">{{avatarName}}</li>
                    {{/headInventory}}
                </ul>
            </div>

            <div class="subsection">
                <div class="subsection-title">상의</div>
                <ul class="inventory-list">
                    {{#topInventory}}
                        <li class="inventory-item">{{avatarName}}</li>
                    {{/topInventory}}
                </ul>
            </div>

            <div class="subsection">
                <div class="subsection-title">하의</div>
                <ul class="inventory-list">
                    {{#bottomInventory}}
                        <li class="inventory-item">{{avatarName}}</li>
                    {{/bottomInventory}}
                </ul>
            </div>

            <div class="subsection">
                <div class="subsection-title">신발</div>
                <ul class="inventory-list">
                    {{#shoesInventory}}
                        <li class="inventory-item">{{avatarName}}</li>
                    {{/shoesInventory}}
                </ul>
            </div>
        </div>

        <form action="/my-page/inventory/change" method="post" class="avatar-form">
            <label for="head">헤드:</label>
            <select id="head" name="head">
                <option value="">선택하세요</option>
                {{#headInventory}}
                    <option value="{{avatarId}}">{{avatarName}}</option>
                {{/headInventory}}
            </select>

            <label for="top">상의:</label>
            <select id="top" name="top">
                <option value="">선택하세요</option>
                {{#topInventory}}
                    <option value="{{avatarId}}">{{avatarName}}</option>
                {{/topInventory}}
            </select>

            <label for="bottom">하의:</label>
            <select id="bottom" name="bottom">
                <option value="">선택하세요</option>
                {{#bottomInventory}}
                    <option value="{{avatarId}}">{{avatarName}}</option>
                {{/bottomInventory}}
            </select>

            <label for="shoes">신발:</label>
            <select id="shoes" name="shoes">
                <option value="">선택하세요</option>
                {{#shoesInventory}}
                    <option value="{{avatarId}}">{{avatarName}}</option>
                {{/shoesInventory}}
            </select>

            <button type="submit" class="submit-button">아바타 변경</button>
        </form>
    </div>
     <script src="https://cdn.jsdelivr.net/npm/mustache@4.2.0/mustache.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
 <script src="/js/mypage.js"></script>